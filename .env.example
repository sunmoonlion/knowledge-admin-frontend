# 管理端 BFF 根地址（登录跳转 /api/auth/login）。必须是 knowledge-admin-backend，端口一般为 8001。
# 切勿填 knowledge-web-backend 的地址（常见 8000），否则 OAuth 由 Web 处理，登录成功后会跳到 Web 的 FRONTEND_URL（如 3000）。
VITE_API_URL=http://localhost:8001

# 是否开启 PWA 调试（true / false）
VITE_PWA_DEBUG=false

# 是否使用 Mock 数据（开发常 true，生产常 false）
VITE_MOCK_ENABLE=false
