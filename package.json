{
  "name": "knowledge-admin-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "cross-env ELECTRON=true vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "cross-env NODE_ENV=production vite preview",
    "build:electron": "cross-env VITE_ELECTRON=true BASE_PATH=./ npm run build && electron-builder",
    "build:electron-only": "electron-builder",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "analysis": "cross-env ANALYSIS=true npm run p",
    "build:debug": "cross-env SOURCE_MAP=true npm run p",
    "p": "run-s build-only preview"
  },
  "dependencies": {
    "@unocss/reset": "^65.4.3",
    "@vueuse/core": "^12.5.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "el-admin-components": "workspace:*",
    "element-plus": "^2.9.3",
    "gsap": "^3.12.7",
    "howler": "^2.2.4",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.0",
    "sortablejs": "^1.15.6",
    "vditor": "^3.10.8",
    "video.js": "^8.21.0",
    "vue": "^3.5.13",
    "vue-echarts": "^6.6.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.301",
    "@iconify/vue": "^4.3.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/howler": "^2.2.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.12.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vitest/eslint-plugin": "1.1.25",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "cypress": "^14.0.1",
    "dotenv": "^16.4.7",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.19.0",
    "eslint-plugin-cypress": "^4.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^8.0.3",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "mockjs": "^1.1.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.83.4",
    "start-server-and-test": "^2.0.10",
    "tree-kill": "^1.2.2",
    "typescript": "~5.7.3",
    "unocss": "^65.4.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "unplugin-vue-router": "^0.11.2",
    "vite": "^6.0.11",
    "vite-plugin-cdn-next": "^1.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^7.7.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.0",
    "workbox-window": "^7.3.0"
  },
  "resolutions": {
    "postcss": "^8.4.21"
  }
}
